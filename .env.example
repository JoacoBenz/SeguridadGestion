# Postgres (use docker-compose locally)
DATABASE_URL="postgresql://paqueteok:paqueteok@localhost:5432/paqueteok?schema=public"

# NextAuth
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Magic-link email provider (Resend in production; logs to console in dev when empty)
RESEND_API_KEY=""
EMAIL_FROM="PaqueteOK <no-reply@paqueteok.app>"

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="set-a-long-random-string"
WHATSAPP_APP_SECRET=""

# Vercel Cron auth for /api/cron/reminders (Vercel sends it as Bearer token)
CRON_SECRET=""

# Foto de paquetes (cualquier storage S3-compatible). Vacío = fotos deshabilitadas en dev.
# Producción usa Supabase Storage: STORAGE_ENDPOINT = https://<ref>.supabase.co/storage/v1/s3,
# STORAGE_PUBLIC_BASE_URL = https://<ref>.supabase.co/storage/v1/object/public/<bucket>.
# (Cloudflare R2 / AWS S3 funcionan igual con sus endpoints.) El bucket es PRIVADO:
# las lecturas salen con URL firmada; la base pública es solo la forma canónica.
STORAGE_BUCKET=""
STORAGE_PUBLIC_BASE_URL=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Public base URL used inside WhatsApp links
PUBLIC_BASE_URL="http://localhost:3000"

# Sentry (error tracking). Sin DSN, Sentry queda apagado (dev). El DSN es
# público (viaja al bundle del cliente); el AUTH_TOKEN es secreto y sólo se usa
# en el build de Vercel para subir source maps.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Rate limiting distribuido (Upstash Redis, plan gratis alcanza). Sin estas
# vars, el limiter cae al modo en-memoria por instancia (best-effort).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
