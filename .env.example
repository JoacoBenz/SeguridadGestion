# Postgres (use docker-compose locally)
DATABASE_URL="postgresql://paqueteok:paqueteok@localhost:5432/paqueteok?schema=public"

# NextAuth
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Magic-link email provider (Resend in production; logs to console in dev when empty)
RESEND_API_KEY=""
EMAIL_FROM="PaqueteOK <no-reply@paqueteok.app>"

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="set-a-long-random-string"
WHATSAPP_APP_SECRET=""

# Public base URL used inside WhatsApp links
PUBLIC_BASE_URL="http://localhost:3000"

# Cron de recordatorios (Vercel Cron manda Authorization: Bearer $CRON_SECRET)
CRON_SECRET="set-a-long-random-string"
