# Postgres (use docker-compose locally)
DATABASE_URL="postgresql://paqueteok:paqueteok@localhost:5432/paqueteok?schema=public"

# NextAuth
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Magic-link email provider (Resend in production; logs to console in dev when empty)
RESEND_API_KEY=""
EMAIL_FROM="PaqueteOK <no-reply@paqueteok.app>"

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="set-a-long-random-string"
WHATSAPP_APP_SECRET=""

# Vercel Cron auth for /api/cron/reminders (Vercel sends it as Bearer token)
CRON_SECRET=""

# Foto de paquetes (S3 o Cloudflare R2). Vacío = las fotos se deshabilitan en dev.
# Para R2: STORAGE_ENDPOINT = https://<accountid>.r2.cloudflarestorage.com, region "auto",
# STORAGE_PUBLIC_BASE_URL = tu dominio público del bucket (r2.dev o custom domain).
STORAGE_BUCKET=""
STORAGE_PUBLIC_BASE_URL=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Public base URL used inside WhatsApp links
PUBLIC_BASE_URL="http://localhost:3000"
