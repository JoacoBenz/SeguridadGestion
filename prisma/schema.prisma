// Multi-tenant package management for residential buildings.
// Tenant = building (consorcio). All tenant-scoped tables carry tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  admin
  guard
  resident
}

enum PackageStatus {
  awaiting_pickup
  picked_up
  cancelled
}

enum NotificationStatus {
  queued
  sent
  delivered
  read
  failed
}

enum VisitorEventKind {
  announced
  door_prompt
}

enum VisitorStatus {
  pending
  confirmed
  rejected
  arrived
  cancelled
  expired
}

enum RecurringAuthStatus {
  active
  paused
  revoked
}

enum IssueKind {
  maintenance
  noise
  suspicious
  panic
  incident
}

enum IssueSeverity {
  low
  normal
  high
  critical
}

enum IssueStatus {
  open
  acknowledged
  resolved
}

enum LostFoundStatus {
  lost
  claimed
  disposed
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  address   String?
  timezone  String   @default("America/Argentina/Buenos_Aires")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  units          Unit[]
  packages       Package[]
  auditLogs      AuditLog[]
  visitorEvents  VisitorEvent[]
  chatSessions   ChatSession[]
  recurringAuths RecurringAuthorization[]
  issues         Issue[]
  broadcasts     Broadcast[]
  faqEntries     FaqEntry[]
  lostFoundItems LostFoundItem[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String?
  role          Role      @default(resident)
  name          String
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  pinHash       String?
  vacationStart DateTime?
  vacationEnd   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant                 Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitMemberships        UnitResident[]
  packagesReceived       Package[]                @relation("PackageReceivedBy")
  packagesDelivered      Package[]                @relation("PackagePickedUpBy")
  auditLogs              AuditLog[]
  accounts               Account[]
  sessions               Session[]
  chatSession            ChatSession?
  visitorEventsRequested VisitorEvent[]           @relation("VisitorEventRequester")
  visitorEventsDecided   VisitorEvent[]           @relation("VisitorEventDecider")
  recurringAuthsCreated  RecurringAuthorization[] @relation("RecurringAuthCreator")
  issuesReported         Issue[]                  @relation("IssueReporter")
  issuesAcknowledged     Issue[]                  @relation("IssueAck")
  issuesResolved         Issue[]                  @relation("IssueResolver")
  broadcastsSent         Broadcast[]              @relation("BroadcastSender")
  lostFoundPosted        LostFoundItem[]          @relation("LostFoundPoster")
  lostFoundClaimed       LostFoundItem[]          @relation("LostFoundClaimer")

  @@index([tenantId, role])
}

// Auth.js (NextAuth v5) — tables required by @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residents      UnitResident[]
  packages       Package[]
  visitorEvents  VisitorEvent[]
  recurringAuths RecurringAuthorization[]
  issues         Issue[]

  @@unique([tenantId, label])
  @@index([tenantId])
}

model UnitResident {
  unitId    String
  userId    String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([unitId, userId])
  @@index([userId])
}

model Package {
  id               String        @id @default(cuid())
  tenantId         String
  unitId           String
  receivedByUserId String
  carrier          String?
  photoUrl         String?
  notes            String?
  pickupCode       String
  pickupToken      String        @default(cuid())
  status           PackageStatus @default(awaiting_pickup)
  receivedAt       DateTime      @default(now())
  pickedUpAt       DateTime?
  pickedUpByUserId String?
  pickupPhotoUrl   String?
  cancelledAt      DateTime?
  cancelledReason  String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit          Unit           @relation(fields: [unitId], references: [id])
  receivedBy    User           @relation("PackageReceivedBy", fields: [receivedByUserId], references: [id])
  pickedUpBy    User?          @relation("PackagePickedUpBy", fields: [pickedUpByUserId], references: [id])
  notifications Notification[]

  // Pickup code uniqueness is enforced only across active packages — see migration that
  // adds a partial unique index on (tenantId, pickupCode) WHERE status = 'awaiting_pickup'.
  @@unique([tenantId, pickupToken])
  @@index([tenantId, status, receivedAt])
  @@index([unitId, status])
}

model Notification {
  id                String             @id @default(cuid())
  packageId         String
  channel           String             @default("whatsapp")
  templateName      String
  recipientPhone    String
  providerMessageId String?
  status            NotificationStatus @default(queued)
  sentAt            DateTime?
  errorPayload      Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([providerMessageId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json     @default("{}")
  at          DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, at])
  @@index([entityType, entityId])
}

model VisitorEvent {
  id                String           @id @default(cuid())
  tenantId          String
  unitId            String
  kind              VisitorEventKind
  visitorName       String
  vehiclePlate      String?
  expectedTime      DateTime?
  status            VisitorStatus    @default(pending)
  requestedByUserId String
  decidedByUserId   String?
  decidedAt         DateTime?
  notes             String?
  createdAt         DateTime         @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        Unit   @relation(fields: [unitId], references: [id])
  requestedBy User   @relation("VisitorEventRequester", fields: [requestedByUserId], references: [id])
  decidedBy   User?  @relation("VisitorEventDecider", fields: [decidedByUserId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([unitId, createdAt])
}

model ChatSession {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String    @unique
  phone          String    @unique
  state          String    @default("MENU")
  context        Json      @default("{}")
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model InboundMessageDedupe {
  providerMessageId String   @id
  processedAt       DateTime @default(now())
}

model RecurringAuthorization {
  id              String              @id @default(cuid())
  tenantId        String
  unitId          String
  createdByUserId String
  name            String
  daysOfWeek      Int[]
  startTime       String
  endTime         String
  validUntil      DateTime?
  status          RecurringAuthStatus @default(active)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit   @relation(fields: [unitId], references: [id])
  createdBy User   @relation("RecurringAuthCreator", fields: [createdByUserId], references: [id])

  @@index([tenantId, status])
  @@index([unitId])
}

model Issue {
  id                   String        @id @default(cuid())
  tenantId             String
  unitId               String?
  kind                 IssueKind
  severity             IssueSeverity @default(normal)
  status               IssueStatus   @default(open)
  title                String
  body                 String
  reportedByUserId     String
  reportedByRole       Role
  acknowledgedByUserId String?
  acknowledgedAt       DateTime?
  resolvedByUserId     String?
  resolvedAt           DateTime?
  resolutionNote       String?
  createdAt            DateTime      @default(now())

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit?  @relation(fields: [unitId], references: [id])
  reportedBy     User   @relation("IssueReporter", fields: [reportedByUserId], references: [id])
  acknowledgedBy User?  @relation("IssueAck", fields: [acknowledgedByUserId], references: [id])
  resolvedBy     User?  @relation("IssueResolver", fields: [resolvedByUserId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, kind, status])
}

model Broadcast {
  id             String   @id @default(cuid())
  tenantId       String
  sentByUserId   String
  subject        String
  body           String
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sentBy User   @relation("BroadcastSender", fields: [sentByUserId], references: [id])

  @@index([tenantId, sentAt])
}

model FaqEntry {
  id        String   @id @default(cuid())
  tenantId  String
  ordinal   Int
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ordinal])
}

model LostFoundItem {
  id              String          @id @default(cuid())
  tenantId        String
  description     String
  foundLocation   String?
  foundAt         DateTime        @default(now())
  postedByUserId  String
  status          LostFoundStatus @default(lost)
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime        @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  postedBy  User   @relation("LostFoundPoster", fields: [postedByUserId], references: [id])
  claimedBy User?  @relation("LostFoundClaimer", fields: [claimedByUserId], references: [id])

  @@index([tenantId, status, foundAt])
}
