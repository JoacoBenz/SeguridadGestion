// Multi-tenant package management for residential buildings.
// Tenant = building (consorcio). All tenant-scoped tables carry tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  superadmin
  admin
  guard
  resident
}

enum PackageStatus {
  awaiting_pickup
  picked_up
  cancelled
}

enum NotificationStatus {
  queued
  sent
  delivered
  read
  failed
}

// Facturación manual (sin pasarela todavía): el superadmin gestiona el estado.
// trial → active cuando el consorcio paga; past_due da gracia; suspended corta
// el registro de paquetes nuevos (los retiros pendientes siguen permitidos).
enum SubscriptionStatus {
  trial
  active
  past_due
  suspended
}

model Tenant {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  address            String?
  timezone           String             @default("America/Argentina/Buenos_Aires")
  settings           Json               @default("{}")
  subscriptionStatus SubscriptionStatus @default(trial)
  // Solo aplica en trial; null = prueba sin vencimiento (decisión explícita).
  trialEndsAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users     User[]
  units     Unit[]
  packages  Package[]
  auditLogs AuditLog[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String?
  role          Role      @default(resident)
  name          String
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  pinHash       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitMemberships   UnitResident[]
  packagesReceived  Package[]       @relation("PackageReceivedBy")
  packagesDelivered Package[]       @relation("PackagePickedUpBy")
  auditLogs         AuditLog[]
  accounts          Account[]
  sessions          Session[]

  @@index([tenantId, role])
}

// Auth.js (NextAuth v5) — tables required by @auth/prisma-adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  residents UnitResident[]
  packages  Package[]

  @@unique([tenantId, label])
  @@index([tenantId])
}

model UnitResident {
  unitId    String
  userId    String
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([unitId, userId])
  @@index([userId])
}

model Package {
  id                 String         @id @default(cuid())
  tenantId           String
  unitId             String
  receivedByUserId   String
  carrier            String?
  photoUrl           String?
  notes              String?
  pickupCode         String
  pickupToken        String         @default(cuid())
  status             PackageStatus  @default(awaiting_pickup)
  receivedAt         DateTime       @default(now())
  pickedUpAt         DateTime?
  pickedUpByUserId   String?
  pickupPhotoUrl     String?
  cancelledAt        DateTime?
  cancelledReason    String?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit           @relation(fields: [unitId], references: [id])
  receivedBy     User           @relation("PackageReceivedBy", fields: [receivedByUserId], references: [id])
  pickedUpBy     User?          @relation("PackagePickedUpBy", fields: [pickedUpByUserId], references: [id])
  notifications  Notification[]

  // Pickup code uniqueness applies only across active packages. Prisma can't
  // express partial unique indexes, so it lives in a custom migration
  // (Package_tenantId_pickupCode_active_key, WHERE status = 'awaiting_pickup').
  // The app layer (generateUniquePickupCode) pre-checks and registerPackage
  // retries on P2002 so a guard never sees the race.
  @@unique([tenantId, pickupToken])
  @@index([tenantId, status, receivedAt])
  @@index([unitId, status])
}

model Notification {
  id                String             @id @default(cuid())
  packageId         String
  channel           String             @default("whatsapp")
  templateName      String
  recipientPhone    String
  providerMessageId String?
  status            NotificationStatus @default(queued)
  sentAt            DateTime?
  errorPayload      Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([providerMessageId])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  metadata     Json     @default("{}")
  at           DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, at])
  @@index([entityType, entityId])
}
